#!/usr/bin/env bash
# bin/ws — workstream tool: render the DAG from GitHub Issues; claim/release node leases;
#           lint readiness; self-healing flip-gate.
#
# WHY (Operator-directed, 2026-07-07, four falsification rounds): (1) the ledger is minimal —
#   node details live on GitHub Issues, the single source of truth; (2) the view is GENERATED
#   on the fly — no committed copy drifts; (3) concurrent-thread-execution invariant (DYAD.md
#   #5): threads work in parallel across branches without collision — leases; (4) node-lifecycle
#   invariant (WS-NL, #14): status:ready MEANS headless-dispatchable to a sub-agent — enforced
#   by lint (structure), the claim gate, and the Actions flip-gate (self-healing).
#
# Node contract (one issue per workstream, labeled `ws`, title "WS…: <name>"):
#   labels    — machine state: exactly one status:* of proposed|ready|in-progress|blocked|
#               elicit|operator|horizon; CLOSED renders as done. Queryable; never in body.
#               Lifecycle (third #5 invariant — Sense closes only by Operator confirmation):
#               new nodes enter status:proposed (the body IS the intent playback); the Operator
#               closes Sense (ready-flip, or a d-land directive the Agent records); claim
#               refuses any node not ready.
#   body      — REQUIRED for ready (WS-NL readiness contract): **Intent** · **Acceptance
#               criteria** · **Context** (pointers; no chat-only knowledge) · **Delivery**
#               (branch, evidence, release path) · resolved **Elicit** · **Depends-on:** all
#               refs CLOSED ("—" = none; use **Relates:** for non-execution links).
#   comments  — the lease journal: `CLAIM branch=<b> ts=<utc>` opens; `RELEASE`/`YIELD` close.
#
# Lint proves STRUCTURE; semantic sufficiency stays with the Operator's flip. The lease
# protocol's no-CAS race window is documented at `claim` below — narrowed by read-back,
# deterministic earliest-claim-wins, adequate at dyad scale.
#
# Usage:  bin/ws                                   # render DAG + pointers + elicit queue
#         bin/ws claim WS3 [branch]               # lease a ready node (lints first)
#         bin/ws release WS3 [--done | --status <s>]
#         bin/ws lint  <WS-id|#N|N>               # readiness contract check (network)
#         bin/ws lint  --fixture <file> [--deps open|closed]   # offline, for criteria/
#         bin/ws gate  <N>                        # flip-gate: revert non-compliant ready
set -euo pipefail

MY_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export WS_GH="$MY_BIN/gh"
export WS_REPO="${DYAD_WS_REPO:-pltrinh1122/dyad-chiron}"
export WS_CUR_BRANCH="$(git -C "$MY_BIN/.." symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")"

exec python3 - "$@" <<'PY'
import json, os, re, subprocess, sys
from datetime import datetime, timezone

GH, REPO = os.environ["WS_GH"], os.environ["WS_REPO"]
REQUIRED_FIELDS = ["Intent", "Acceptance criteria", "Context", "Delivery"]

def gh(*args, parse=False):
    r = subprocess.run([GH, *args, "-R", REPO], capture_output=True, text=True)
    if r.returncode != 0:
        sys.stderr.write(r.stderr)
        sys.exit(1)
    return json.loads(r.stdout) if parse else r.stdout

def field(body, name):
    m = re.search(rf"\*\*{name}:\*\*\s*(.+)", body or "")
    return m.group(1).strip() if m else ""

def section_text(body, name):
    """Text from a **Name:** marker to the next field marker / heading / rule; None if absent."""
    m = re.search(rf"\*\*{name}:\*\*", body or "")
    if not m:
        return None
    rest = (body or "")[m.end():]
    nxt = re.search(r"\n\*\*[A-Z][a-zA-Z -]*:\*\*|\n#{1,6} |\n---", rest)
    return (rest[: nxt.start()] if nxt else rest).strip()

def nodes():
    issues = gh("issue", "list", "--label", "ws", "--state", "all", "--limit", "200",
                "--json", "number,title,state,url,body,labels", parse=True)
    out = {}
    for i in sorted(issues, key=lambda x: x["number"]):
        m = re.match(r"(WS[\w-]+):", i["title"])
        if m:
            out[m.group(1)] = i
    return out

def resolve(ns, key):
    """Accept 'WS-X', '#14', or '14'."""
    if key in ns:
        return key, ns[key]
    k = key.lstrip("#")
    if k.isdigit():
        for ws, i in ns.items():
            if i["number"] == int(k):
                return ws, i
    sys.exit(f"ws: unknown node '{key}'")

def status_of(i):
    if i["state"] == "CLOSED":
        return "done"
    for l in i["labels"]:
        if l["name"].startswith("status:"):
            return l["name"].split(":", 1)[1]
    return "open"

def active_leases(number):
    """Replay the lease journal: CLAIM opens, RELEASE/YIELD closes. -> {branch: ts}"""
    comments = gh("issue", "view", str(number), "--json", "comments", parse=True)["comments"]
    open_leases = {}
    for c in comments:
        m = re.match(r"(CLAIM|RELEASE|YIELD)\s+branch=(\S+)", c["body"])
        if not m:
            continue
        verb, branch = m.groups()
        if verb == "CLAIM":
            open_leases.setdefault(branch, c["createdAt"])
        else:
            open_leases.pop(branch, None)
    return open_leases

def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

# --- readiness lint (WS-NL, #14) -------------------------------------------------------------

def open_elicit(body):
    e = field(body, "Elicit")
    if not e:
        return None
    t = e.lstrip("—–- ").strip().lower()
    if t == "" or t.startswith("none") or t.startswith("(none"):
        return None
    return e

def lint_misses(body, dep_state):
    """dep_state: fn(issue_number:int) -> 'OPEN'|'CLOSED'. Returns list of contract misses."""
    misses = []
    for f in REQUIRED_FIELDS:
        s = section_text(body, f)
        if s is None or len(s) < 8:
            misses.append(f"missing field: {f}")
    if open_elicit(body):
        misses.append(f"open elicit: {open_elicit(body)}")
    for d in re.findall(r"#(\d+)", field(body, "Depends-on")):
        if dep_state(int(d)) != "CLOSED":
            misses.append(f"dependency open: #{d}")
    return misses

def live_dep_state(n):
    return gh("issue", "view", str(n), "--json", "state", parse=True)["state"]

def lint_report(label, misses):
    if misses:
        print(f"ws lint: {label} FAILS the readiness contract:")
        for m in misses:
            print(f"  MISS {m}")
        return 1
    print(f"ws lint: {label} passes the readiness contract.")
    return 0

# --- commands --------------------------------------------------------------------------------

def render():
    ns = nodes()
    by_num = {i["number"]: ws for ws, i in ns.items()}
    print("# WORKSTREAMS — generated view (source of truth: GitHub Issues; do not edit)\n")
    print("```mermaid\ngraph LR")
    for ws, i in ns.items():
        print(f'  {ws}["{ws} · {status_of(i)}"]')
    for ws, i in ns.items():
        for d in re.findall(r"#(\d+)", field(i["body"], "Depends-on")):
            if int(d) in by_num:
                print(f"  {by_num[int(d)]} --> {ws}")
    print("```\n")
    print("| id | workstream | status | node |")
    print("|----|------------|--------|------|")
    elicits = []
    for ws, i in ns.items():
        st = status_of(i)
        if st == "in-progress":
            leases = active_leases(i["number"])
            st = f"in-progress @ {', '.join(leases) or '??'}"
        title = i["title"].split(":", 1)[1].strip()
        print(f"| {ws} | {title} | {st} | [#{i['number']}]({i['url']}) |")
        e = open_elicit(i["body"])
        if e and i["state"] != "CLOSED":
            elicits.append((ws, i["number"], e))
    if elicits:
        print("\n## Elicit queue (Operator-only knowledge)\n")
        for ws, n, e in elicits:
            print(f"- **{ws}** (#{n}): {e}")

def claim(ws_id, branch):
    protected = subprocess.run([os.path.dirname(GH) + "/_dyad-rt", "protected"],
                               capture_output=True, text=True).stdout.strip() or "main"
    if not branch or branch == protected:
        sys.exit(f"ws claim: refusing lease for branch '{branch}' — work happens on working branches.")
    ns = nodes()
    ws_id, i = resolve(ns, ws_id)
    st = status_of(i)
    if st != "ready":
        sys.exit(f"ws claim: {ws_id} is '{st}', not 'ready' — not claimable (collision guard).")
    misses = lint_misses(i["body"], live_dep_state)
    if misses:
        sys.exit(f"ws claim: {ws_id} refused by readiness lint (WS-NL): " + "; ".join(misses))
    n = str(i["number"])
    if active_leases(i["number"]):
        sys.exit(f"ws claim: {ws_id} already has an active lease — not claimable (collision guard).")
    gh("issue", "comment", n, "--body", f"CLAIM branch={branch} ts={now()}")
    gh("issue", "edit", n, "--add-label", "status:in-progress", "--remove-label", "status:ready")
    leases = active_leases(i["number"])          # read-back: did we race?
    earliest = min(leases, key=leases.get) if leases else None
    if earliest != branch:
        gh("issue", "comment", n, "--body", f"YIELD branch={branch} ts={now()} (lost race to {earliest})")
        print(f"ws claim: lost race for {ws_id} to '{earliest}' — yielded.", file=sys.stderr)
        sys.exit(2)
    print(f"ws claim: {ws_id} leased to branch '{branch}' (#{n}).")

def release(ws_id, args):
    ns = nodes()
    ws_id, i = resolve(ns, ws_id)
    n = str(i["number"])
    branch = os.environ.get("WS_CUR_BRANCH", "")
    leases = active_leases(i["number"])
    if branch not in leases:
        sys.exit(f"ws release: no active lease for branch '{branch}' on {ws_id} (active: {list(leases) or 'none'}).")
    gh("issue", "comment", n, "--body", f"RELEASE branch={branch} ts={now()}")
    if "--done" in args:
        gh("issue", "edit", n, "--remove-label", "status:in-progress")
        gh("issue", "close", n)
        print(f"ws release: {ws_id} done and closed (#{n}).")
    else:
        new = args[args.index("--status") + 1] if "--status" in args else "ready"
        gh("issue", "edit", n, "--add-label", f"status:{new}", "--remove-label", "status:in-progress")
        print(f"ws release: {ws_id} lease ended, status:{new} (#{n}).")

def lint_cmd(args):
    if args and args[0] == "--fixture":
        body = open(args[1]).read()
        deps = "closed"
        if "--deps" in args:
            deps = args[args.index("--deps") + 1]
        dep_state = (lambda n: "CLOSED") if deps == "closed" else (lambda n: "OPEN")
        sys.exit(lint_report(args[1], lint_misses(body, dep_state)))
    ws_id, i = resolve(nodes(), args[0])
    sys.exit(lint_report(ws_id, lint_misses(i["body"], live_dep_state)))

def gate(key):
    """Self-healing flip-gate: a status:ready node failing lint is reverted to proposed."""
    ws_id, i = resolve(nodes(), key)
    if i["state"] == "CLOSED" or status_of(i) != "ready":
        print(f"ws gate: {ws_id} is '{status_of(i)}' — nothing to gate.")
        return
    misses = lint_misses(i["body"], live_dep_state)
    if not misses:
        print(f"ws gate: {ws_id} passes — ready stands.")
        return
    n = str(i["number"])
    gh("issue", "edit", n, "--add-label", "status:proposed", "--remove-label", "status:ready")
    gh("issue", "comment", n, "--body",
       "⛔ readiness flip-gate (WS-NL, #14): reverted ready → proposed — the readiness contract is not met:\n"
       + "\n".join(f"- {m}" for m in misses)
       + "\n\nFix the node body (and close open dependencies), then re-flip.")
    print(f"ws gate: {ws_id} reverted ready → proposed ({len(misses)} misses; self-healed).")

argv = sys.argv[1:]
if not argv:
    render()
elif argv[0] == "claim":
    claim(argv[1], argv[2] if len(argv) > 2 else os.environ.get("WS_CUR_BRANCH", ""))
elif argv[0] == "release":
    release(argv[1], argv[2:])
elif argv[0] == "lint":
    lint_cmd(argv[1:])
elif argv[0] == "gate":
    gate(argv[1])
else:
    sys.exit(f"ws: unknown subcommand '{argv[0]}' — see usage in the file header")
PY
