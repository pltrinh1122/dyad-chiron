#!/usr/bin/env bash
# bin/ws — workstream tool: render the DAG from GitHub Issues; drive the node lifecycle
#           (converge / dland / claim / release); lint readiness; self-healing flip-gate.
#
# WHY (Operator-directed, 2026-07-07, five falsification rounds + lifecycle ratification #16):
#   (1) minimal ledger — node details live on GitHub Issues, the single source of truth;
#   (2) views are GENERATED on the fly — no committed copy drifts; (3) concurrent-thread-
#   execution invariant (DYAD.md #5): parallel threads, no node collision — leases;
#   (4) readiness contract (#14): dispose MEANS headless-dispatchable — lint + claim gate +
#   Actions flip-gate; (5) stream labels (#15): node identity = issue #, grouping =
#   ws:<stream> labels, titles are free text — native filtering.
#
# Lifecycle (ratified #16, 2026-07-07 — statuses ARE the Activity Board lanes, 1:1; the
# lifecycle is the Operator's at-a-glance command view; attention = clarification + disposition):
#
#     clarify → dispose → execute → blocked   (+ done = CLOSED)
#
#   clarify  — Sense open; Operator input due. New nodes enter here (the body IS the
#              intent playback, per DYAD.md #5 third invariant).
#   dispose  — Sense converged, contract passes; Operator go/no-go due. Also home of pure
#              Operator-act nodes. clarify → dispose is settable ONLY via the lint-gated
#              `ws converge` assertion (invariant 1).
#   execute  — disposition given; agents' hands. dispose → execute IS the disposition
#              (invariant 2): an Operator label flip, or a d-land directive recorded via
#              `ws dland`. Lock state on the card: `execute` alone = authorized, awaiting
#              a thread; `execute` + `lock:<branch>` = in that thread's hands.
#   blocked  — dependencies unmet; reason on the card (optional **Blocked:** body field,
#              e.g. "unscheduled"). Blocked bars EXECUTION only — Sense is permeable
#              (Operator clarification, 2026-07-07): body refinement, elicitation, and
#              amendments on a blocked node are deliberately allowed; Sense converges while
#              dependencies clear. Enforced at two points: claim refuses (stage + lint
#              deps-check), and promotion to dispose is impossible while deps are open.
#              Known gap: unblocking is manual today; candidate self-heal = the board
#              sync (#13) auto-promoting blocked nodes whose deps have all closed.
#
#   Staleness gate (Operator amendment, 2026-07-07): convergence is TIMESTAMPED — the
#   CONVERGE journal comment — and is INVALID if any Depends-on ref closed AFTER it
#   (ground mutated under the convergence). lint reports it; gate and claim self-heal
#   the node to clarify with a comment naming which dependency moved, for a cheap
#   re-grounding confirmation (not a full re-Sense). Claim is the last gate before
#   execution — late-emerging ground mutation is caught there.
#
#   d-land on a non-dispose node: state the risk ("Sense not converged") and PROCEED —
#   warn, not halt (invariant 3, Operator urgency override). Policy point (invariant 2):
#   disposition flips to standing authorization per stream when the Operator elects it
#   (Agent self-dispatches on convergence; Operator veto stands) — until then, every
#   disposition is an Operator turn, and `ws turns` derives the metric: disposition-turns
#   per node = timestamped `status:execute` label events (Operator flips and recorded
#   d-land directives both land one) + DISPOSITION journal comments as the directive record.
#
# Node contract (one issue per node; membership = exactly one `ws:<stream>` label — no bare marker):
#   labels    — machine state: exactly one status:* of clarify|dispose|execute|blocked;
#               CLOSED renders as done. Queryable; never in body. `lock:<branch>` = the
#               visible lease holder (claim adds, release removes) — a board-visible CACHE;
#               the CLAIM/RELEASE journal stays authoritative (invariant 4).
#   body      — REQUIRED for dispose (readiness contract, #14): **Intent** · **Acceptance
#               criteria** · **Context** (pointers; no chat-only knowledge) · **Delivery**
#               (branch, evidence, release path) · resolved **Elicit** · **Depends-on:** all
#               refs CLOSED ("—" = none; use **Relates:** for non-execution links). Field
#               markers may carry qualifier text before the colon (defect found live on #14).
#   comments  — the journal: `CLAIM branch=<b> ts=<utc>` opens a lease; `RELEASE`/`YIELD`
#               close it; `CONVERGE ts=<utc>` asserts Sense-closure; `DISPOSITION d-land
#               ts=<utc>` records a directive.
#
# Lint proves STRUCTURE; semantic sufficiency stays with the Operator's disposition. The lease
# protocol's no-CAS race window: claim-comment + read-back, deterministic earliest-claim-wins,
# millisecond window — adequate at dyad scale, named rather than hidden.
#
# Usage:  bin/ws                                   # render DAG + lanes + elicit queue
#         bin/ws board                             # render the Activity Board (markdown) — the Observe channel (#13)
#         bin/ws board --fixture <file>            # offline board render from a node-list JSON, for criteria/
#         bin/ws sync-project [--plan|--dry-run]   # self-heal the Projects v2 board from issue+label state (#25)
#         bin/ws sync-project --fixture <file>     # offline node→lane mapping, network-free, for criteria/
#         bin/ws converge <#N|N>                   # Agent asserts Sense converged: clarify → dispose (lint-gated)
#         bin/ws dland <#N|N> ["<directive>"]      # record a d-land disposition: → execute (warns off-dispose)
#         bin/ws claim <#N|N> [branch]             # lease an execute node (lints; adds lock:<branch>)
#         bin/ws release <#N|N> [--done | --status <s>]   # end lease (removes lock:<branch>);
#                                                  #   --done is earnedness-gated (#26): refused unless every
#                                                  #   acceptance criterion is a checked task-list box
#         bin/ws lint  <#N|N>                      # readiness contract check (network)
#         bin/ws lint  --fixture <file> [--deps open|closed]   # offline, for criteria/
#         bin/ws gate  <#N|N>                      # flip-gate: revert non-compliant dispose → clarify
#         bin/ws earned <#N|N>                     # dry-run the close gate (#26): clear to --done?
#         bin/ws earned --fixture <file>           # offline, for criteria/
#         bin/ws turns <#N|N>                      # disposition-turn metric (timestamped events)
#         bin/ws attend                            # Classification O — the Operator's attention read model (#47): Eisenhower quadrants over the claimable queue
set -euo pipefail

MY_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export WS_GH="$MY_BIN/gh"
export WS_REPO="${DYAD_WS_REPO:-pltrinh1122/dyad-chiron}"
export WS_CUR_BRANCH="$(git -C "$MY_BIN/.." symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")"

exec python3 - "$@" <<'PY'
import json, os, re, subprocess, sys
from datetime import datetime, timezone

GH, REPO = os.environ["WS_GH"], os.environ["WS_REPO"]
REQUIRED_FIELDS = ["Intent", "Acceptance criteria", "Context", "Delivery"]
STATUSES = ["clarify", "dispose", "execute", "blocked"]   # = board lanes, 1:1 (#16 invariant 5)

def gh(*args, parse=False):
    r = subprocess.run([GH, *args, "-R", REPO], capture_output=True, text=True)
    if r.returncode != 0:
        sys.stderr.write(r.stderr)
        sys.exit(1)
    return json.loads(r.stdout) if parse else r.stdout

def gh_api(path, parse=True):
    """gh api call (no -R flag — the path names the repo)."""
    r = subprocess.run([GH, "api", "--method", "GET", "-H", "Accept: application/vnd.github+json",
                        "-F", "per_page=100", path], capture_output=True, text=True)
    if r.returncode != 0:
        sys.stderr.write(r.stderr)
        sys.exit(1)
    return json.loads(r.stdout) if parse else r.stdout

def marker(name):
    """A **Field:** marker; qualifier text before the colon is tolerated —
    e.g. **Intent (converged via elicitation, 2026-07-07):** (defect found live on #14)."""
    return rf"\*\*{name}\b[^:*\n]*:\*\*"

def field(body, name):
    m = re.search(marker(name) + r"\s*(.+)", body or "")
    return m.group(1).strip() if m else ""

def section_text(body, name):
    """Text from a **Name:** marker to the next field marker / heading / rule; None if absent."""
    m = re.search(marker(name), body or "")
    if not m:
        return None
    rest = (body or "")[m.end():]
    nxt = re.search(r"\n\*\*[A-Z][^:*\n]*:\*\*|\n#{1,6} |\n---", rest)
    return (rest[: nxt.start()] if nxt else rest).strip()

def nodes():
    """All nodes, keyed by issue number. Membership = carrying a ws:<stream> label (#15 —
    no bare marker label; the stream label IS the node marker)."""
    issues = gh("issue", "list", "--state", "all", "--limit", "200",
                "--json", "number,title,state,url,body,labels,closedAt", parse=True)
    return {i["number"]: i for i in sorted(issues, key=lambda x: x["number"])
            if any(l["name"].startswith("ws:") for l in i["labels"])}

def resolve(ns, key):
    k = str(key).lstrip("#")
    if k.isdigit() and int(k) in ns:
        return int(k), ns[int(k)]
    sys.exit(f"ws: unknown node '{key}' (nodes are ws-labeled issues, addressed by number)")

def stream_of(i):
    for l in i["labels"]:
        if l["name"].startswith("ws:"):
            return l["name"].split(":", 1)[1]
    return "-"

def status_of(i):
    """done = CLOSED; else the status:* label. Exactly one per open node (invariant 5) —
    zero or several is a visible breach, rendered as-is rather than papered over."""
    if i["state"] == "CLOSED":
        return "done"
    found = [l["name"].split(":", 1)[1] for l in i["labels"] if l["name"].startswith("status:")]
    return "+".join(found) if found else "none"

def lock_of(i):
    """The lock:<branch> label — the board-visible lease holder (cache; journal authoritative)."""
    for l in i["labels"]:
        if l["name"].startswith("lock:"):
            return l["name"].split(":", 1)[1]
    return None

def status_labels(i):
    return [l["name"] for l in i["labels"] if l["name"].startswith("status:")]

def active_leases(number):
    """Replay the lease journal: CLAIM opens, RELEASE/YIELD closes. -> {branch: ts}"""
    comments = gh("issue", "view", str(number), "--json", "comments", parse=True)["comments"]
    open_leases = {}
    for c in comments:
        m = re.match(r"(CLAIM|RELEASE|YIELD)\s+branch=(\S+)", c["body"])
        if not m:
            continue
        verb, branch = m.groups()
        if verb == "CLAIM":
            open_leases.setdefault(branch, c["createdAt"])
        else:
            open_leases.pop(branch, None)
    return open_leases

def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

# --- readiness lint (#14) --------------------------------------------------------------------

def open_elicit(body):
    e = field(body, "Elicit")
    if not e:
        return None
    t = e.lstrip("—–- ").strip().lower()
    if t == "" or t.startswith("none") or t.startswith("(none"):
        return None
    return e

def lint_misses(body, dep_state):
    """dep_state: fn(issue_number:int) -> 'OPEN'|'CLOSED'. Returns list of contract misses."""
    misses = []
    for f in REQUIRED_FIELDS:
        s = section_text(body, f)
        if s is None or len(s) < 8:
            misses.append(f"missing field: {f}")
    if open_elicit(body):
        misses.append(f"open elicit: {open_elicit(body)}")
    for d in re.findall(r"#(\d+)", field(body, "Depends-on")):
        if dep_state(int(d)) != "CLOSED":
            misses.append(f"dependency open: #{d}")
    return misses

def live_dep_state(n):
    return gh("issue", "view", str(n), "--json", "state", parse=True)["state"]

# --- earnedness gate on close (#26) ------------------------------------------------------------

def unmet_acceptance(body):
    """Closing a node is a claim — 'its acceptance criteria were earned' — so `release --done`
    must find them enumerated as a task list with every box checked (#13 breach: closed done
    with criteria the shipped surface could not satisfy; the Operator had to ask, not see).
    Returns a refusal string, or None when the node is clear to close. Evidences *enumerated
    disposition* of each criterion, not the *truth* of each — the full coach-absent check stays
    NOT_YET_WIRED (proxies are evidence, never closure)."""
    section = section_text(body, "Acceptance criteria")
    if section is None:
        return "no **Acceptance criteria** section — a done claim cannot be evidenced."
    boxes = re.findall(r"^[ \t]*[-*][ \t]+\[([ xX])\][ \t]*(.+?)[ \t]*$", section, re.M)
    if not boxes:
        return ("**Acceptance criteria** carries no task-list checkboxes — render each criterion "
                "as `- [ ] …` so `done` is evidenced box-by-box, never conferred.")
    unmet = [txt for mark, txt in boxes if mark == " "]
    if unmet:
        listed = "\n".join(f"      - [ ] {t}" for t in unmet)
        return (f"{len(unmet)} acceptance criterion(s) unmet — closing would confer what was not "
                f"earned:\n{listed}\n    Carve-out: move the unmet criteria to a successor node "
                f"(Depends-on this one), then close only the earned remainder.")
    return None

# --- staleness gate (#16, Operator amendment 2026-07-07) ---------------------------------------

def latest_converge_ts(number):
    """The latest CONVERGE journal timestamp — convergence is timestamped, not a bare flag."""
    comments = gh("issue", "view", str(number), "--json", "comments", parse=True)["comments"]
    ts = None
    for c in comments:
        m = re.match(r"CONVERGE ts=(\S+)", c["body"])
        if m:
            ts = m.group(1)
    return ts

def stale_deps(number, body):
    """Convergence is INVALID if any Depends-on ref closed AFTER the latest CONVERGE ts —
    ground mutated under the convergence. -> [(dep, closedAt, converge_ts), ...]"""
    ts = latest_converge_ts(number)
    if not ts:
        return []
    stale = []
    for d in re.findall(r"#(\d+)", field(body, "Depends-on")):
        info = gh("issue", "view", d, "--json", "state,closedAt", parse=True)
        if info["state"] == "CLOSED" and (info.get("closedAt") or "") > ts:
            stale.append((int(d), info["closedAt"], ts))
    return stale

def heal_stale(n, i, stale):
    """Self-heal a stale convergence to clarify, naming which dependency moved."""
    args = ["issue", "edit", str(n), "--add-label", "status:clarify"]
    for l in status_labels(i):
        args += ["--remove-label", l]
    gh(*args)
    gh("issue", "comment", str(n), "--body",
       "⛔ staleness gate (#16): convergence invalidated — ground mutated under it:\n"
       + "\n".join(f"- dependency #{d} closed {c} AFTER CONVERGE {t}" for d, c, t in stale)
       + "\n\nReverted to clarify for a cheap re-grounding confirmation (not a full re-Sense), "
         "then re-assert convergence (`bin/ws converge`).")

def lint_report(label, misses):
    if misses:
        print(f"ws lint: {label} FAILS the readiness contract:")
        for m in misses:
            print(f"  MISS {m}")
        return 1
    print(f"ws lint: {label} passes the readiness contract.")
    return 0

# --- commands --------------------------------------------------------------------------------

def render():
    ns = nodes()
    print("# WORKSTREAMS — generated view (source of truth: GitHub Issues; do not edit)\n")
    print("```mermaid\ngraph LR")
    for n, i in ns.items():
        print(f'  N{n}["#{n} · {status_of(i)}"]')
    for n, i in ns.items():
        for d in re.findall(r"#(\d+)", field(i["body"], "Depends-on")):
            if int(d) in ns:
                print(f"  N{d} --> N{n}")
    print("```\n")
    print("| node | title | stream | status |")
    print("|------|-------|--------|--------|")
    elicits = []
    for n, i in ns.items():
        st = status_of(i)
        if st == "execute":
            lock = lock_of(i)
            st = f"execute @ {lock}" if lock else "execute (awaiting a thread)"
        elif st == "blocked":
            reason = field(i["body"], "Blocked")
            if reason:
                st = f"blocked ({reason})"
        print(f"| [#{n}]({i['url']}) | {i['title']} | {stream_of(i)} | {st} |")
        e = open_elicit(i["body"])
        if e and i["state"] != "CLOSED":
            elicits.append((n, e))
    if elicits:
        print("\n## Elicit queue (Operator-only knowledge)\n")
        for n, e in elicits:
            print(f"- **#{n}**: {e}")

# --- Activity Board render core (#13) ---------------------------------------------------------
# The token-INDEPENDENT engine both Observe surfaces consume: the interim pinned "Activity Board"
# issue (current token, ratified fallback (a)) and the future Projects v2 board (Operator provisions
# a project-scoped token). Policy single-homes HERE; Actions = trigger + transport only. Data has
# NO branch home — it is pulled from gh-issue state (labels + issue open/closed); only this render
# code has a branch home (Operator's data-source check, #13 SENSE-converged, 2026-07-07).

BOARD_LANES = ["clarify", "dispose", "execute", "blocked", "done"]   # ratified columns (#16 1:1)
DONE_CAP = 10                                                        # done = most-recent DONE_CAP

def card(n, i):
    """One board card from node data: id+title link · lock:<branch> holder · blocked-by #refs ·
    Blocked: reason · elicit marker. Every bit is derived — no second home for any of it."""
    bits = [f"**[#{n}]({i['url']})** {i['title']}"]
    lock = lock_of(i)
    if lock:
        bits.append(f"`lock:{lock}`")
    if status_of(i) == "blocked":               # blocked-by #refs + Blocked: reason belong to
        deps = re.findall(r"#(\d+)", field(i["body"], "Depends-on"))   # the blocked lane only —
        if deps:                                                       # scoping also stops a
            bits.append("blocked-by " + " ".join(f"#{d}" for d in deps))   # prose **Blocked:**
        reason = field(i["body"], "Blocked")                           # marker in another lane's
        if reason:                                                     # body from leaking onto it
            bits.append(f"Blocked: {reason}")
    if i["state"] != "CLOSED":
        e = open_elicit(i["body"])
        if e:
            bits.append(f"⚑ elicit: {e}")
    return "- " + " · ".join(bits)

def board(args):
    """Render the Activity Board as markdown from the single-home node data. Offline via
    --fixture <json> (an issues list — the same shape bin/ws reads) so criteria/ grounds the
    render core with no network/token."""
    if args and args[0] == "--fixture":
        issues = json.load(open(args[1]))
        ns = {i["number"]: i for i in sorted(issues, key=lambda x: x["number"])}
    else:
        ns = nodes()

    buckets = {l: [] for l in BOARD_LANES}
    breaches = []
    for n, i in ns.items():
        st = status_of(i)
        if st in buckets:
            buckets[st].append((n, i))
        elif i["state"] == "CLOSED":
            buckets["done"].append((n, i))
        else:                                   # zero/multi status:* — a visible breach, surfaced
            breaches.append((n, i))
    buckets["done"].sort(key=lambda p: p[1].get("closedAt") or "", reverse=True)
    done_total = len(buckets["done"])
    buckets["done"] = buckets["done"][:DONE_CAP]

    out = ["# Activity Board", ""]
    out.append("> generated — source of truth is issues/labels · do not edit "
               "(regenerated by `.github/workflows/activity-board.yml` from `bin/ws board`).")
    out.append("")
    for lane in BOARD_LANES:
        cards = buckets[lane]
        head = f"## {lane}  ({len(cards)})"
        if lane == "done" and done_total > DONE_CAP:
            head = f"## {lane}  ({len(cards)} most-recent of {done_total})"
        out.append(head)
        out.extend(card(n, i) for n, i in cards)
        if not cards:
            out.append("_(none)_")
        out.append("")
    if breaches:
        out.append("## ⚠ unlaned (status breach — not exactly one status:*)")
        out.extend(card(n, i) for n, i in breaches)
        out.append("")
    out.append("## Legend — the three label families")
    out.append("- `ws:<stream>` — membership: which workstream a node belongs to")
    out.append("- `status:<lane>` — lifecycle lane (clarify · dispose · execute · "
               "blocked; a closed issue = done)")
    out.append("- `lock:<branch>` — lease holder (board-visible cache; the CLAIM/RELEASE "
               "journal stays authoritative)")
    print("\n".join(out))

# --- Activity Board — Projects v2 self-healing sync (#25) --------------------------------------
# The Projects v2 board is a VIEW-ONLY PROJECTION of issue+label state (#13 Q3): labels stay
# canonical; every sync OVERWRITES the board's Status to match, so any manual card drag is
# reverted on the next run (self-healing one-way sync). Sync POLICY single-homes HERE — lane
# mapping, ws-only scope (#13 Q4), done-cap — mirroring the markdown board's split; the Actions
# job (activity-board-project.yml) is TRIGGER + TRANSPORT only. Data has NO branch home: pulled
# from gh-issue state. The board is self-describing — resolved by TITLE under the repo owner,
# with its Status option-ids read at runtime, so no magic IDs live in code (survives board
# recreation). Consumes the #34 DYAD_PROJECT_TOKEN secret in CI; a local run uses ambient login.

PROJECT_TITLE = os.environ.get("DYAD_PROJECT_TITLE", "Activity Board")

_ADD_Q = ("mutation($pid:ID!,$cid:ID!){addProjectV2ItemById(input:{projectId:$pid,contentId:$cid})"
          "{item{id}}}")
_SET_Q = ("mutation($pid:ID!,$iid:ID!,$fid:ID!,$oid:String!){updateProjectV2ItemFieldValue(input:{"
          "projectId:$pid,itemId:$iid,fieldId:$fid,value:{singleSelectOptionId:$oid}})"
          "{projectV2Item{id}}}")
_DEL_Q = "mutation($pid:ID!,$iid:ID!){deleteProjectV2Item(input:{projectId:$pid,itemId:$iid}){deletedItemId}}"
_ARCH_Q = "mutation($pid:ID!,$iid:ID!){archiveProjectV2Item(input:{projectId:$pid,itemId:$iid}){item{id}}}"
_UNARCH_Q = "mutation($pid:ID!,$iid:ID!){unarchiveProjectV2Item(input:{projectId:$pid,itemId:$iid}){item{id}}}"

def gql(query, soft=False, **vars):
    """A gh GraphQL call. Omitted/None vars are simply not sent (so a nullable $cursor becomes
    null → first page). soft=True returns None on error instead of exiting (best-effort steps)."""
    args = [GH, "api", "graphql", "-f", f"query={query}"]
    for k, v in vars.items():
        if v is not None:
            args += ["-f", f"{k}={v}"]
    r = subprocess.run(args, capture_output=True, text=True)
    if r.returncode != 0:
        if soft:
            return None
        sys.stderr.write(r.stderr)
        sys.exit(1)
    return json.loads(r.stdout)["data"]

def project_resolve():
    """Resolve the board by TITLE under the repo owner → (project_id, status_field_id,
    {lane: option_id}). Fails loudly if the board or a lane option is absent — the board's
    column set is a precondition, not something sync silently invents."""
    owner = REPO.split("/")[0]
    q = ('query($login:String!){repositoryOwner(login:$login){... on ProjectV2Owner{'
         'projectsV2(first:30){nodes{number title id field(name:"Status"){'
         '... on ProjectV2SingleSelectField{id options{id name}}}}}}}}')
    data = gql(q, login=owner)
    projs = ((data.get("repositoryOwner") or {}).get("projectsV2") or {}).get("nodes", [])
    for p in projs:
        if p["title"] == PROJECT_TITLE:
            f = p.get("field") or {}
            if not f:
                sys.exit(f"ws sync-project: board '{PROJECT_TITLE}' has no Status single-select field.")
            opts = {o["name"]: o["id"] for o in f["options"]}
            missing = [l for l in BOARD_LANES if l not in opts]
            if missing:
                sys.exit(f"ws sync-project: Status field is missing lane option(s) {missing}; "
                         f"add them to '{PROJECT_TITLE}' (columns must be {BOARD_LANES}).")
            return p["id"], f["id"], opts
    sys.exit(f"ws sync-project: no ProjectV2 titled '{PROJECT_TITLE}' under '{owner}'.")

def project_items(pid):
    """Every board item, paged → ({issue_number: (item_id, status, archived)}, [(item_id, archived)]).
    Issue-content items key by number (membership decided later against the node set); DraftIssue /
    PullRequest content is never a node, so its item is extraneous outright. `archived` is carried
    so a re-run does not re-archive (idempotence) and a reopened node can be unarchived."""
    q = ('query($pid:ID!,$cursor:String){node(id:$pid){... on ProjectV2{items(first:100,after:$cursor){'
         'pageInfo{hasNextPage endCursor} nodes{id isArchived content{__typename ... on Issue{number}} '
         'status:fieldValueByName(name:"Status"){... on ProjectV2ItemFieldSingleSelectValue{name}}}}}}}')
    members, extraneous, cursor = {}, [], None
    while True:
        conn = gql(q, pid=pid, cursor=cursor)["node"]["items"]
        for it in conn["nodes"]:
            c = it.get("content") or {}
            st = (it.get("status") or {}).get("name")
            arch = bool(it.get("isArchived"))
            if c.get("__typename") == "Issue" and "number" in c:
                members[c["number"]] = (it["id"], st, arch)
            else:
                extraneous.append((it["id"], arch))
        if conn["pageInfo"]["hasNextPage"]:
            cursor = conn["pageInfo"]["endCursor"]
        else:
            return members, extraneous

def desired_lane(i):
    """The board lane a node projects to: a clean single status:* (or done=CLOSED). A zero/multi
    status:* breach has no clean lane → None (Status left unset, surfaced — never guessed; the
    detection of that breach is #30's axis)."""
    st = status_of(i)
    return st if st in BOARD_LANES else None

def sync_plan(ns, members, extraneous):
    """The reconcile plan — pure given (node set, live board snapshot). ws-only scope (#13 Q4):
    any board item not backing a current ws node is removed; done beyond DONE_CAP (most-recent by
    closedAt) is archived, keeping the done lane bounded exactly like the markdown board caps it."""
    desired = {n: desired_lane(i) for n, i in ns.items()}
    done_ranked = sorted([n for n, l in desired.items() if l == "done"],
                         key=lambda n: ns[n].get("closedAt") or "", reverse=True)
    cap_archive = set(done_ranked[DONE_CAP:])
    add, setl, unarchive, archive, breach = [], [], [], [], []
    for n, i in ns.items():
        lane = desired[n]
        item = members.get(n)                 # (item_id, status, archived) or None
        if lane is None:
            breach.append(n)                  # a live node with no clean lane — leave it, surface it
            continue
        if n in cap_archive:                  # done beyond cap → belongs archived (not on active board)
            if item and not item[2]:
                archive.append((n, item[0]))
            continue
        if item is None:                      # active node not yet on the board
            add.append((n, lane))
        elif item[2]:                         # active node whose item is archived (e.g. reopened) → restore
            unarchive.append((n, item[0], lane))
        elif item[1] != lane:                 # only mutate on real drift → clean diff, fewer calls
            setl.append((n, item[0], lane))
    remove = [(num, members[num][0]) for num in members if num not in ns] \
             + [(None, iid) for iid, arch in extraneous if not arch]   # archived non-node = already off-board
    return {"add": add, "set": setl, "unarchive": unarchive,
            "archive": archive, "remove": remove, "breach": breach}

def _plan_total(plan):
    return sum(len(plan[k]) for k in ("add", "set", "unarchive", "archive", "remove"))

def print_plan(plan):
    if _plan_total(plan) == 0 and not plan["breach"]:
        print("ws sync-project: board already current — nothing to reconcile.")
        return 0
    for n, lane in plan["add"]:
        print(f"  + add       #{n} → {lane}")
    for n, _, lane in plan["set"]:
        print(f"  ~ status    #{n} → {lane}")
    for n, _, lane in plan["unarchive"]:
        print(f"  ↥ unarchive #{n} → {lane} (node active again)")
    for num, _ in plan["remove"]:
        print(f"  - remove    {('#' + str(num)) if num else 'non-issue item'} (not a ws node)")
    for n, _ in plan["archive"]:
        print(f"  ⤓ archive   #{n} (done beyond cap {DONE_CAP})")
    for n in plan["breach"]:
        print(f"  ⚠ breach    #{n}: no clean status:* lane — Status left unset (detection = #30)")
    print(f"ws sync-project: {_plan_total(plan)} change(s) planned"
          + (f", {len(plan['breach'])} breach(es)" if plan["breach"] else "") + ".")
    return 0

def project_apply(pid, fid, opts, plan):
    for n, lane in plan["add"]:
        cid = gh("issue", "view", str(n), "--json", "id", parse=True)["id"]
        iid = gql(_ADD_Q, pid=pid, cid=cid)["addProjectV2ItemById"]["item"]["id"]
        gql(_SET_Q, pid=pid, iid=iid, fid=fid, oid=opts[lane])
        print(f"  + #{n} → {lane}")
    for n, iid, lane in plan["set"]:
        gql(_SET_Q, pid=pid, iid=iid, fid=fid, oid=opts[lane])
        print(f"  ~ #{n} → {lane}")
    for n, iid, lane in plan["unarchive"]:
        gql(_UNARCH_Q, pid=pid, iid=iid)
        gql(_SET_Q, pid=pid, iid=iid, fid=fid, oid=opts[lane])
        print(f"  ↥ #{n} → {lane}")
    for num, iid in plan["remove"]:
        gql(_DEL_Q, pid=pid, iid=iid)
        print(f"  - removed {('#' + str(num)) if num else 'non-issue item'}")
    for n, iid in plan["archive"]:
        ok = gql(_ARCH_Q, soft=True, pid=pid, iid=iid)
        print(f"  ⤓ archived #{n}" if ok else f"  (note: could not archive #{n} — may already be archived)")

def sync_project(args):
    """Self-healing one-way sync of the Projects v2 board (#25). `--fixture <json>` maps a node
    list to lanes offline (network-free, for criteria/); `--plan`/`--dry-run` prints the live
    reconcile diff without mutating (AC: provable by local-run diff); bare form applies it."""
    if args and args[0] == "--fixture":
        issues = json.load(open(args[1]))
        ns = {i["number"]: i for i in sorted(issues, key=lambda x: x["number"])
              if any(l["name"].startswith("ws:") for l in i.get("labels", []))}
        for n, i in ns.items():
            lane = desired_lane(i)
            print(f"  #{n} → {lane if lane else '⚠ breach (no clean status:* lane)'}")
        print(f"ws sync-project --fixture: {len(ns)} ws-node(s) mapped.")
        return
    ns = nodes()
    pid, fid, opts = project_resolve()
    members, extraneous = project_items(pid)
    plan = sync_plan(ns, members, extraneous)
    if args and args[0] in ("--plan", "--dry-run"):
        sys.exit(print_plan(plan))
    if _plan_total(plan) == 0:
        print(f"ws sync-project: board '{PROJECT_TITLE}' already current — nothing drifted.")
    else:
        print(f"ws sync-project: reconciling {_plan_total(plan)} change(s) on '{PROJECT_TITLE}'…")
        project_apply(pid, fid, opts, plan)
    for n in plan["breach"]:
        print(f"  ⚠ breach #{n}: no clean status:* lane — Status left unset (detection = #30).")
    print("ws sync-project: done.")

def converge(key):
    """Invariant 1 (#16): clarify → dispose is settable ONLY here — the Agent's lint-gated
    assertion that Sense has converged and the node meets the readiness contract (#14)."""
    n, i = resolve(nodes(), key)
    st = status_of(i)
    if st != "clarify":
        sys.exit(f"ws converge: #{n} is '{st}', not 'clarify' — nothing to assert.")
    misses = lint_misses(i["body"], live_dep_state)
    if misses:
        sys.exit(f"ws converge: #{n} refused by readiness lint (#14): " + "; ".join(misses))
    gh("issue", "comment", str(n), "--body",
       f"CONVERGE ts={now()} — Sense asserted converged (lint-gated, #16 invariant 1); awaiting disposition.")
    gh("issue", "edit", str(n), "--add-label", "status:dispose", "--remove-label", "status:clarify")
    print(f"ws converge: #{n} clarify → dispose — awaiting the Operator's go/no-go.")

def dland(key, text):
    """Invariant 2 (#16): record a d-land directive — the disposition — and flip to execute.
    Invariant 3: on a non-dispose node, warn ('Sense not converged') and PROCEED — the
    Operator's urgency override halts nothing."""
    n, i = resolve(nodes(), key)
    if i["state"] == "CLOSED":
        sys.exit(f"ws dland: #{n} is closed — nothing to dispose.")
    st = status_of(i)
    note = ""
    if st != "dispose":
        print(f"ws dland: WARNING — #{n} is '{st}', not 'dispose': Sense not converged; "
              f"proceeding on Operator urgency override (#16 invariant 3).", file=sys.stderr)
        note = f" (urgency override from '{st}': Sense not converged)"
    body = f"DISPOSITION d-land ts={now()}{note}" + (f" — {text}" if text else "")
    gh("issue", "comment", str(n), "--body", body)
    args = ["issue", "edit", str(n), "--add-label", "status:execute"]
    for l in status_labels(i):
        args += ["--remove-label", l]
    gh(*args)
    print(f"ws dland: #{n} → execute (disposition recorded).")

def claim(key, branch):
    """Invariant 4 (#16): claim gates on execute + readiness lint + no active lease.
    The lease lands a lock:<branch> label — the board-visible holder (cache; the
    CLAIM/RELEASE journal stays authoritative)."""
    protected = subprocess.run([os.path.dirname(GH) + "/_dyad-rt", "protected"],
                               capture_output=True, text=True).stdout.strip() or "main"
    if not branch or branch == protected:
        sys.exit(f"ws claim: refusing lease for branch '{branch}' — work happens on working branches.")
    n, i = resolve(nodes(), key)
    st = status_of(i)
    if st != "execute":
        sys.exit(f"ws claim: #{n} is '{st}', not 'execute' — no disposition given, not claimable (#16 invariant 4).")
    misses = lint_misses(i["body"], live_dep_state)
    if misses:
        sys.exit(f"ws claim: #{n} refused by readiness lint (#14): " + "; ".join(misses))
    stale = stale_deps(n, i["body"])
    if stale:                                    # the last gate before execution (#16)
        heal_stale(n, i, stale)
        sys.exit(f"ws claim: #{n} refused by the staleness gate (#16) — convergence predates "
                 f"dependency closure ({', '.join(f'#{d}' for d, _, _ in stale)}); self-healed to clarify.")
    if active_leases(n):
        sys.exit(f"ws claim: #{n} already has an active lease — not claimable (collision guard).")
    gh("label", "create", f"lock:{branch}", "--color", "FBCA04", "--force",
       "--description", f"lease held by branch {branch} (visible cache; journal authoritative)")
    gh("issue", "comment", str(n), "--body", f"CLAIM branch={branch} ts={now()}")
    gh("issue", "edit", str(n), "--add-label", f"lock:{branch}")
    leases = active_leases(n)                    # read-back: did we race?
    earliest = min(leases, key=leases.get) if leases else None
    if earliest != branch:
        gh("issue", "comment", str(n), "--body", f"YIELD branch={branch} ts={now()} (lost race to {earliest})")
        gh("issue", "edit", str(n), "--remove-label", f"lock:{branch}")
        print(f"ws claim: lost race for #{n} to '{earliest}' — yielded.", file=sys.stderr)
        sys.exit(2)
    print(f"ws claim: #{n} leased to branch '{branch}' (lock:{branch}).")

def release(key, args):
    n, i = resolve(nodes(), key)
    branch = os.environ.get("WS_CUR_BRANCH", "")
    leases = active_leases(n)
    if branch not in leases:
        sys.exit(f"ws release: no active lease for branch '{branch}' on #{n} (active: {list(leases) or 'none'}).")
    if "--done" in args:                       # earnedness gate (#26) — check BEFORE any mutation
        refusal = unmet_acceptance(i["body"])   # so a refusal leaves the lease fully intact
        if refusal:
            sys.exit(f"ws release: refusing to close #{n} — {refusal}\n  (lease intact — nothing changed.)")
    gh("issue", "comment", str(n), "--body", f"RELEASE branch={branch} ts={now()}")
    gh("issue", "edit", str(n), "--remove-label", f"lock:{branch}")
    if "--done" in args:
        gh("issue", "edit", str(n), "--remove-label", "status:execute")
        gh("issue", "close", str(n))
        print(f"ws release: #{n} done and closed — all acceptance criteria checked.")
    elif "--status" in args:
        new = args[args.index("--status") + 1]
        if new not in STATUSES:
            sys.exit(f"ws release: unknown status '{new}' — lanes are {' | '.join(STATUSES)} (#16 invariant 5).")
        if new != "execute":
            gh("issue", "edit", str(n), "--add-label", f"status:{new}", "--remove-label", "status:execute")
        print(f"ws release: #{n} lease ended, status:{new}.")
    else:
        print(f"ws release: #{n} lease ended — stays execute (authorized, awaiting a thread).")

def lint_cmd(args):
    if args and args[0] == "--fixture":
        body = open(args[1]).read()
        deps = "closed"
        if "--deps" in args:
            deps = args[args.index("--deps") + 1]
        dep_state = (lambda n: "CLOSED") if deps == "closed" else (lambda n: "OPEN")
        sys.exit(lint_report(args[1], lint_misses(body, dep_state)))
    n, i = resolve(nodes(), args[0])
    misses = lint_misses(i["body"], live_dep_state)
    misses += [f"stale convergence: #{d} closed {c} AFTER CONVERGE {t}"
               for d, c, t in stale_deps(n, i["body"])]
    sys.exit(lint_report(f"#{n}", misses))

def gate(key):
    """Self-healing flip-gate: a status:dispose node failing lint is reverted to clarify;
    so is one whose convergence went stale (staleness gate). Execute is NOT lint-gated —
    disposition is the Operator's, and the urgency override (invariant 3) may legitimately
    put a non-converged node in agents' hands (claim still runs the staleness gate)."""
    n, i = resolve(nodes(), key)
    if i["state"] == "CLOSED" or status_of(i) != "dispose":
        print(f"ws gate: #{n} is '{status_of(i)}' — nothing to gate.")
        return
    stale = stale_deps(n, i["body"])
    if stale:
        heal_stale(n, i, stale)
        print(f"ws gate: #{n} reverted dispose → clarify — stale convergence "
              f"({', '.join(f'#{d}' for d, _, _ in stale)} closed after CONVERGE; self-healed).")
        return
    misses = lint_misses(i["body"], live_dep_state)
    if not misses:
        print(f"ws gate: #{n} passes — dispose stands.")
        return
    gh("issue", "edit", str(n), "--add-label", "status:clarify", "--remove-label", "status:dispose")
    gh("issue", "comment", str(n), "--body",
       "⛔ readiness flip-gate (#14): reverted dispose → clarify — the readiness contract is not met:\n"
       + "\n".join(f"- {m}" for m in misses)
       + "\n\nFix the node body (and close open dependencies), then re-assert convergence (`bin/ws converge`).")
    print(f"ws gate: #{n} reverted dispose → clarify ({len(misses)} misses; self-healed).")

def turns(key):
    """The disposition-turn metric (#16 invariant 2): every disposition — Operator flip or
    recorded d-land — lands exactly one timestamped `status:execute` labeled event; DISPOSITION
    journal comments carry the directive record. Count the events, list both."""
    n, i = resolve(nodes(), key)
    events = gh_api(f"repos/{REPO}/issues/{n}/timeline")
    flips = [e for e in events
             if e.get("event") == "labeled" and (e.get("label") or {}).get("name") == "status:execute"]
    comments = gh("issue", "view", str(n), "--json", "comments", parse=True)["comments"]
    directives = [c for c in comments if re.match(r"DISPOSITION\b", c["body"])]
    for e in flips:
        print(f"  disposition (execute-flip)  {e.get('created_at', '?')}  by {(e.get('actor') or {}).get('login', '?')}")
    for c in directives:
        print(f"  directive (journal)         {c['createdAt']}  {c['body'].splitlines()[0]}")
    print(f"ws turns: #{n} disposition-turns = {len(flips)}")

def earned_cmd(args):
    """Dry-run the earnedness close gate (#26): is this node clear for `release --done`?
    Exit 0 = every acceptance criterion is a checked box (clear to close); nonzero = refused,
    with the reason. `--fixture <file>` runs the gate on a body file offline (criteria hook,
    mirrors `lint --fixture`). The same `unmet_acceptance` powers the real close in release()."""
    if args and args[0] == "--fixture":
        body = open(args[1]).read()
    else:
        n, i = resolve(nodes(), args[0])
        body = i["body"]
    refusal = unmet_acceptance(body)
    if refusal:
        sys.exit(f"ws earned: NOT clear to close — {refusal}")
    print("ws earned: clear to close — all acceptance criteria checked.")

# --- Classification O — the Operator's attention read model (#47) ------------------------------
# WHAT: `ws attend` — a GENERATED VIEW that ranks the claimable queue into Eisenhower quadrants so
#       the Operator can triage toward the telos at a glance. The CQRS read/query projection of
#       reflect/decision-architecture.md (model O); model A (the write/execution side) is the follow-on.
# WHO ELECTED IT: Operator-directed via node #47 — d-sense rulings A3·B1·C1, 2026-07-09.
# WHY: "what should I attend to now, to best move the telos?" was un-answerable at a glance — the
#       ledger/DAG carried the signal but nothing projected it. Per the three rulings:
#   C1 (eligibility) — show ONLY Operator-turn ∧ actionable = open nodes with status ∈ {clarify,
#       dispose}. execute (Agent-turn), blocked (not actionable) and closed are excluded.
#   A3 (importance) — DAG-criticality × telos-lever, COMBINED: criticality = position on the
#       curriculum spine to the #11 summit + transitive unblock-count; lever weights it so
#       enabling-only nodes rank below telos-bearing ones on the same path.
#   B1 (render) — Eisenhower QUADRANTS, not a scalar. importance/urgency each bucketed hi/lo on
#       ordinal cutoffs; important∧urgent surfaced first. NO fabricated numeric priority is emitted
#       (earnedness: marginal learning-turns aren't cardinally measurable — stay ordinal).
# INVARIANTS:
#   §4.2 single-source — a pure PROJECTION of the write model (issues/labels/journal/DAG). No stored
#       priority; every signal is recomputed here at render time from the live ledger.
#   §4.1 freshness — RECOMPUTE-ON-READ *is* the freshness guarantee: computed fresh on every
#       invocation, it cannot be stale. If a node's own convergence went stale (a Depends-on closed
#       after its CONVERGE — the #16 signal), that is surfaced in its row.

CURRICULUM_SPINE = [4, 5, 8, 6, 9, 10, 11]         # #4→#5→#8→#6→#9→#10→#11; #11 = the graduation summit
LEVER_WEIGHT = {"efficacy": 4, "turn-reduction": 3, "graduation": 2, "enabling": 1}   # by directness (A3)

def lever_of(i):
    """The telos-lever:* facet (A3 write-model tag) — which telos mechanism the node pulls, or None."""
    for l in i["labels"]:
        if l["name"].startswith("telos-lever:"):
            return l["name"].split(":", 1)[1]
    return None

def attend(args):
    """Classification O (#47): recompute the attention read model fresh from the live ledger and
    render it as Eisenhower quadrants. Projection-only — nothing is stored (§4.2); recompute-on-read
    is the freshness guarantee (§4.1)."""
    ns = nodes()
    open_ns = {n: i for n, i in ns.items() if i["state"] != "CLOSED"}

    # Depends-on DAG over the OPEN set (blocking/unblock pressure lives among open nodes).
    deps = {n: [int(d) for d in re.findall(r"#(\d+)", field(i["body"], "Depends-on"))
                if int(d) in open_ns] for n, i in open_ns.items()}
    direct_dependents = {n: [m for m, ds in deps.items() if n in ds] for n in open_ns}

    def downstream(n, seen):
        for m in direct_dependents.get(n, []):
            if m not in seen:
                seen.add(m)
                downstream(m, seen)
        return seen

    # C1 eligibility filter — Operator-turn ∧ actionable only.
    attention = {n: i for n, i in open_ns.items() if status_of(i) in ("clarify", "dispose")}

    rows = []
    for n, i in attention.items():
        lever = lever_of(i)
        lw = LEVER_WEIGHT.get(lever, LEVER_WEIGHT["enabling"])   # untagged → enabling weight (falsifiable default)
        on_spine = n in CURRICULUM_SPINE
        unblock = len(downstream(n, set()))                     # transitive open nodes downstream of n
        blocking = len(direct_dependents[n])                    # open nodes directly waiting on n
        # A3 importance = DAG-criticality × lever, combined. dagc = spine position + unblock reach;
        # importance = lever_weight × (1 + dagc) so off-spine importance comes from the lever (dagc=0 →
        # importance = lever_weight), and on a shared path the lever multiplies criticality (enabling < telos-bearing).
        dagc = unblock + (2 if on_spine else 0)
        importance = lw * (1 + dagc)
        # urgency = blocking-count + staleness. Staleness (#16) only applies to a CONVERGED node
        # (dispose); a clarify node has no convergence to invalidate, so we skip the network probe.
        stale = stale_deps(n, i["body"]) if status_of(i) == "dispose" else []
        urgency = blocking + (1 if stale else 0)
        rows.append({"n": n, "i": i, "lever": lever, "on_spine": on_spine,
                     "unblock": unblock, "blocking": blocking, "stale": stale,
                     "importance": importance, "urgency": urgency})

    # B1 ordinal buckets. importance hi = telos-bearing / DAG-critical (> the enabling floor of 1);
    # urgency hi = the node blocks ≥1 open node or its convergence is stale. Cutoffs are ordinal —
    # no scalar priority is emitted; the composite integers only bucket and order, they are never printed.
    def imp_hi(r):
        return r["importance"] > 1
    def urg_hi(r):
        return r["urgency"] >= 1

    quadrants = [
        ("🔴 important · urgent — attend first", lambda r: imp_hi(r) and urg_hi(r)),
        ("🟠 important · not urgent — schedule", lambda r: imp_hi(r) and not urg_hi(r)),
        ("🟡 not important · urgent — delegate/dispatch", lambda r: not imp_hi(r) and urg_hi(r)),
        ("⚪ not important · not urgent — someday", lambda r: not imp_hi(r) and not urg_hi(r)),
    ]

    out = ["# ATTEND — Classification O, the Operator's attention read model (generated view)", ""]
    out.append("> generated — a PROJECTION of the write model (issues · labels · journal · DAG); "
               "nothing stored (§4.2). Recomputed fresh on every `bin/ws attend`, so it cannot be "
               "stale (§4.1 freshness = recompute-on-read).")
    out.append("> **C1** shows only `Operator-turn ∧ actionable` (status clarify/dispose); "
               "execute/blocked/closed are excluded. **A3** importance = DAG-criticality × telos-lever "
               "(combined). **B1** Eisenhower quadrants, ordinal — no scalar priority.")
    out.append("")
    if not attention:
        out.append("_(attention queue empty — no open clarify/dispose nodes needing the Operator.)_")
        print("\n".join(out))
        return

    def row_line(r):
        n, i = r["n"], r["i"]
        bits = [f"**[#{n}]({i['url']})** {i['title']}"]
        bits.append(f"`{status_of(i)}`")
        bits.append(f"lever: {r['lever'] or '—(untagged→enabling)'}")
        if r["on_spine"]:
            bits.append("on curriculum spine→#11")
        if r["unblock"]:
            bits.append(f"unblocks {r['unblock']} downstream")
        if r["blocking"]:
            bits.append(f"blocks {r['blocking']} open")
        if r["stale"]:
            bits.append("⚠ convergence STALE (dep closed after CONVERGE — re-ground)")
        return "- " + " · ".join(bits)

    for title, pred in quadrants:
        cell = [r for r in rows if pred(r)]
        # order within the cell by importance then urgency then node — ordinal, scores never printed
        cell.sort(key=lambda r: (-r["importance"], -r["urgency"], r["n"]))
        out.append(f"## {title}  ({len(cell)})")
        out.extend(row_line(r) for r in cell) if cell else out.append("_(none)_")
        out.append("")

    out.append("## Legend")
    out.append("- **importance** (A3) = DAG-criticality × telos-lever, combined: criticality = "
               "curriculum-spine position toward the #11 summit + transitive unblock reach; the "
               "`telos-lever` facet (efficacy > turn-reduction > graduation > enabling) weights it, "
               "so enabling-only nodes rank below telos-bearing ones on the same path.")
    out.append("- **urgency** = open nodes directly blocked on this node + staleness (a convergence "
               "invalidated by a dependency that closed after it, #16).")
    out.append("- **ordinal only** — quadrants, never a fabricated numeric score: marginal "
               "learning-turns are not cardinally measurable (earnedness).")
    out.append("- lever tags are **falsifiable read-model defaults** surfaced for Operator review "
               "(CLASSIFY journal comments carry each rationale), not authoritative.")
    print("\n".join(out))

argv = sys.argv[1:]
if not argv:
    render()
elif argv[0] == "board":
    board(argv[1:])
elif argv[0] == "sync-project":
    sync_project(argv[1:])
elif argv[0] == "converge":
    converge(argv[1])
elif argv[0] == "dland":
    dland(argv[1], " ".join(argv[2:]))
elif argv[0] == "claim":
    claim(argv[1], argv[2] if len(argv) > 2 else os.environ.get("WS_CUR_BRANCH", ""))
elif argv[0] == "release":
    release(argv[1], argv[2:])
elif argv[0] == "lint":
    lint_cmd(argv[1:])
elif argv[0] == "gate":
    gate(argv[1])
elif argv[0] == "turns":
    turns(argv[1])
elif argv[0] == "earned":
    earned_cmd(argv[1:])
elif argv[0] == "attend":
    attend(argv[1:])
else:
    sys.exit(f"ws: unknown subcommand '{argv[0]}' — see usage in the file header")
